{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "public/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py?route=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}
